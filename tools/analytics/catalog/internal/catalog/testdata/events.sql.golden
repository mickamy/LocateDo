-- Generated by tools/analytics/catalog from shared/analytics/catalog.yaml. Do not edit.
-- One row per exported event, with the parameters the apps send as columns.
SELECT
  PARSE_DATE('%Y%m%d', event_date) AS event_date,
  TIMESTAMP_MICROS(event_timestamp) AS event_time,
  event_name,
  -- The app was on screen. Reminders, RevenueCat's rc_* events, and Firebase's automatic ones also come in while it
  -- is closed, so these four are what counts a user as active.
  event_name IN ('session_start', 'user_engagement', 'screen_view', 'daily_state') AS foreground,
  user_pseudo_id,
  platform,
  device.mobile_brand_name AS device_brand,
  app_info.version AS app_version,
  geo.country AS country,
  device.language AS language,
  (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'firebase_screen') AS screen,
  (SELECT value.string_value FROM UNNEST(user_properties) WHERE key = 'plan') AS user_plan,
  (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'campaign_id') AS campaign_id,
  (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'completed_todo_count_7d') AS completed_todo_count_7d,
  (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'from') AS auth_from,
  (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'has_url') AS has_url,
  (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'radius_m') AS radius_m,
  (
    SELECT COALESCE(value.double_value, value.float_value, CAST(value.int_value AS FLOAT64))
    FROM UNNEST(event_params) WHERE key = 'value'
  ) AS value,
  (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'watch_app_installed') AS watch_app_installed,
  event_value_in_usd
FROM `__PROJECT__.__SOURCE__.events_*`
-- Streaming export adds events_intraday_* tables that repeat days already in the daily tables.
WHERE _TABLE_SUFFIX NOT LIKE 'intraday%'
