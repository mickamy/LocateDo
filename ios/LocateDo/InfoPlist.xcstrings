{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleName" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StopBy"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここメモ"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StopBy needs your location in the background to remind you when you arrive at a place. Your location is never sent to our servers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "場所に着いたときにお知らせするため、バックグラウンドでも位置情報が必要です。現在地は私たちのサーバーに送りません。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StopBy uses your location to show the places near you and the distance to them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くの場所と、そこまでの距離を表示するために位置情報を使います。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
