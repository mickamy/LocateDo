    "always_prompt.allow" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow “Always”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「常に許可」にする"
          }
        }
      }
    },
    "always_prompt.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To notice when you arrive while StopBy is closed, iOS needs location access set to “Always”. You can change this anytime in Settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを閉じている間も到着に気づくには、位置情報を「常に許可」にする必要があります。あとから設定で変更できます。"
          }
        }
      }
    },
    "always_prompt.later" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not now"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あとで"
          }
        }
      }
    },
    "always_prompt.privacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrivals are detected on your phone, and your location is never sent to our servers or to your family."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到着したかどうかはスマホの中だけで判定し、現在地は私たちのサーバーにも家族にも送りません。"
          }
        }
      }
    },
    "always_prompt.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remind you even when the app is closed"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを閉じていてもお知らせ"
          }
