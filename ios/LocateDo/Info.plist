<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>FirebaseAutomaticScreenReportingEnabled</key>
	<false/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LocateDoAppStatusURL</key>
	<string>$(LOCATEDO_APP_STATUS_URL)</string>
	<key>LocateDoAPIBaseURL</key>
	<string>$(LOCATEDO_API_BASE_URL)</string>
	<key>LocateDoAPSEnvironment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<key>LocateDoGoogleClientID</key>
	<string>$(LOCATEDO_GOOGLE_CLIENT_ID)</string>
	<key>LocateDoGoogleServerClientID</key>
	<string>$(LOCATEDO_GOOGLE_SERVER_CLIENT_ID)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(LOCATEDO_GOOGLE_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>LocateDoRevenueCatAPIKey</key>
	<string>$(LOCATEDO_REVENUECAT_API_KEY)</string>
	<key>LocateDoConfiguration</key>
	<string>$(CONFIGURATION)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
