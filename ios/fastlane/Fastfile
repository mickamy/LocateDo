require "open3"

default_platform(:ios)
skip_docs

APP_IDENTIFIER = "com.locatedo.LocateDo"
STAGING_APP_IDENTIFIER = "com.locatedo.LocateDo.stg"
DEV_APP_IDENTIFIER = "com.locatedo.LocateDo.dev"
NOTIFICATION_CONTENT_SUFFIX = ".NotificationContent"
WATCH_SUFFIX = ".watchkitapp"
PROJECT = "LocateDo.xcodeproj"
# One build folder for every UI-test lane, so later runs and other languages only build what changed.
UI_TEST_DERIVED_DATA = File.expand_path("../build/ui-tests/DerivedData", __dir__)
# Archives build here so the Crashlytics upload-symbols tool from the SPM checkout has a fixed path.
ARCHIVE_DERIVED_DATA = File.expand_path("../build/archive/DerivedData", __dir__)
# deliver reads app previews from <locale>/ folders and takes the display size from the file name.
APP_PREVIEWS = File.expand_path("app_previews", __dir__)
APP_PREVIEW_FILE = "IPHONE_67.mp4"
# Watch shots sit next to the iPhone ones in fastlane/screenshots, where deliver tells them apart by size.
WATCH_SCREENSHOT_PREFIX = "watch-"

# The app, its notification content extension, and its Watch app, each signed with its own profile.
def signed_identifiers(app_identifier)
  [app_identifier, "#{app_identifier}#{NOTIFICATION_CONTENT_SUFFIX}", "#{app_identifier}#{WATCH_SUFFIX}"]
end

# Creates the Watch simulator when it is missing; device is a device type name such as "Apple Watch Ultra 3 (49mm)".
def watch_simulator_udid(device)
  devices = JSON.parse(`xcrun simctl list devices available --json`)["devices"]
  match = devices.values.flatten.find { |candidate| candidate["name"] == device }
  return match["udid"] if match

  `xcrun simctl create "#{device}" "#{device}"`.strip.tap do |udid|
    UI.user_error!("Could not create a #{device} simulator; is the watchOS runtime installed?") if udid.empty?
  end
end

def simulator_udid(device)
  devices = JSON.parse(`xcrun simctl list devices available --json`)["devices"]
  match = devices.values.flatten.find { |candidate| candidate["name"] == device }
  UI.user_error!("No available simulator named #{device}") unless match
  match["udid"]
end

# Builds the Debug app with the store icon and starts an erased simulator with it installed and "Always" granted. With
# a language other than the simulator's English, the simulator itself switches to it, so the lock screen matches the
# app.
def prepare_recording_simulator(udid, language: nil)
  root = File.expand_path("..", __dir__)
  derived_data = UI_TEST_DERIVED_DATA
  sh("xcodebuild", "build-for-testing", "-project", File.join(root, PROJECT), "-scheme", "dev",
     "-destination", "id=#{udid}", "-derivedDataPath", derived_data,
     "ASSETCATALOG_COMPILER_APPICON_NAME=AppIcon")
  sh("xcrun", "simctl", "shutdown", udid, error_callback: ->(_) {})
  sh("xcrun", "simctl", "erase", udid)
  sh("xcrun", "simctl", "boot", udid)
  sh("xcrun", "simctl", "bootstatus", udid, "-b")
  if language && language != "en-US"
    locale = language == "ja" ? "ja_JP" : language.tr("-", "_")
    sh("xcrun", "simctl", "spawn", udid, "defaults", "write", "-g", "AppleLanguages", "-array", language)
    sh("xcrun", "simctl", "spawn", udid, "defaults", "write", "-g", "AppleLocale", "-string", locale)
    sh("xcrun", "simctl", "shutdown", udid)
    boot_simulator(udid)
  end
  sh("xcrun", "simctl", "status_bar", udid, "override", "--time", "9:41",
     "--batteryState", "charged", "--batteryLevel", "100")
  # Granted up front so the recording shows neither the permission alerts nor the "Always" banner.
  sh("xcrun", "simctl", "install", udid, File.join(derived_data, "Build/Products/Debug-iphonesimulator/LocateDo.app"))
  sh("xcrun", "simctl", "privacy", udid, "grant", "location-always", DEV_APP_IDENTIFIER)
end

def test_without_building_command(udid, test, results)
  root = File.expand_path("..", __dir__)
  ["xcodebuild", "test-without-building", "-project", File.join(root, PROJECT), "-scheme", "dev",
   "-destination", "id=#{udid}", "-derivedDataPath", UI_TEST_DERIVED_DATA, "-parallel-testing-enabled", "NO",
   "-resultBundlePath", results, "-only-testing:LocateDoUITests/#{test}",
   "-test-timeouts-enabled", "YES", "-maximum-test-execution-time-allowance", "300"]
end

# After a crash xcodebuild relaunches the runner and can report a pass with no tests run.
def verify_single_pass(results, test)
  summary = JSON.parse(sh("xcrun", "xcresulttool", "get", "test-results", "summary", "--path", results, log: false))
  return if summary["passedTests"] == 1 && summary["failedTests"].zero?

  UI.user_error!("#{test} did not pass exactly once: #{summary.slice('passedTests', 'failedTests', 'skippedTests')}")
end

# Starts recording the simulator into path and returns once simctl says it is recording.
def start_recording(udid, path)
  reader, writer = IO.pipe
  recorder = Process.spawn("xcrun", "simctl", "io", udid, "recordVideo", "--codec", "h264", "--force", path,
                           out: writer, err: writer)
  writer.close
  reader.each_line { |line| break if line.include?("Recording started") }
  recorder
end

def stop_recording(recorder)
  Process.kill("INT", recorder)
  Process.wait(recorder)
end

# Prepares the simulator and runs one UI test while the whole screen is recorded to <work>/raw.mp4. Returns the
# test output and when recording began.
def record_ui_test(udid:, work:, test:, env: {})
  FileUtils.mkdir_p(work)
  prepare_recording_simulator(udid)
  results = File.join(work, "results.xcresult")
  FileUtils.rm_rf(results)
  # The clock starts when simctl reports "Recording started", which comes a few seconds after the spawn.
  recorder = start_recording(udid, File.join(work, "raw.mp4"))
  recording_started = Time.now.to_f
  previous = env.keys.to_h { |key| [key, ENV.fetch(key, nil)] }
  output = nil
  begin
    ENV.update(env)
    output = sh(*test_without_building_command(udid, test, results))
  ensure
    ENV.update(previous)
    stop_recording(recorder)
  end
  verify_single_pass(results, test)
  [output, recording_started]
end

# Prepares the simulator and runs AppPreviewTests, recording each scene into <work>/<scene>.mp4 on its own, so
# nothing has to be found in one long recording. The test prints "PREVIEW <scene> start" and waits for
# <scene>.recording in the signals folder, then prints "PREVIEW <scene> end" and waits for <scene>.stopped.
# Returns the scenes recorded.
def record_preview_scenes(udid:, work:, language:, env: {})
  FileUtils.rm_rf(work)
  signals = File.join(work, "signals")
  FileUtils.mkdir_p(signals)
  prepare_recording_simulator(udid, language: language)
  results = File.join(work, "results.xcresult")
  recorded = []
  recorder = nil
  log = []
  previous = env.keys.to_h { |key| [key, ENV.fetch(key, nil)] }
  begin
    ENV.update(env.merge("TEST_RUNNER_PREVIEW_SIGNALS" => signals))
    Open3.popen2e(*test_without_building_command(udid, "AppPreviewTests", results)) do |_stdin, out, status|
      out.each_line do |line|
        log << line
        if (name = line[/PREVIEW (\w+) start/, 1]) && recorder.nil?
          recorder = start_recording(udid, File.join(work, "#{name}.mp4"))
          FileUtils.touch(File.join(signals, "#{name}.recording"))
        elsif (name = line[/PREVIEW (\w+) end/, 1]) && recorder
          stop_recording(recorder)
          recorder = nil
          recorded << name
          FileUtils.touch(File.join(signals, "#{name}.stopped"))
        end
      end
      UI.user_error!("AppPreviewTests failed:\n#{log.last(40).join}") unless status.value.success?
    end
  ensure
    ENV.update(previous)
    stop_recording(recorder) if recorder
  end
  verify_single_pass(results, "AppPreviewTests")
  recorded
end

# Grants and system alerts are unreliable until the simulator has finished booting.
def boot_simulator(udid)
  sh("xcrun", "simctl", "boot", udid)
  sh("xcrun", "simctl", "bootstatus", udid, "-b")
end

# Seconds into the recording for a time printed by the test. The first frame lands about two seconds
# after simctl prints "Recording started" (measured on the review video).
def recording_offset(time, recording_started)
  (time - recording_started - 2).clamp(0, nil).round(2)
end

platform :ios do
  # produce still wants an Apple ID login, so this talks to the API directly.
  desc "Create the App IDs (the apps with push notifications, their notification extensions, and their Watch apps) and point at the App Store Connect record"
  lane :bootstrap do
    api_key
    connect_api
    push = Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS
    {
      APP_IDENTIFIER => "LocateDo",
      STAGING_APP_IDENTIFIER => "LocateDo Staging",
      DEV_APP_IDENTIFIER => "LocateDo Dev"
    }.each do |identifier, name|
      {
        "#{identifier}#{NOTIFICATION_CONTENT_SUFFIX}" => "#{name} Notification Content",
        "#{identifier}#{WATCH_SUFFIX}" => "#{name} Watch"
      }.each do |embedded, embedded_name|
        if Spaceship::ConnectAPI::BundleId.find(embedded)
          UI.message("#{embedded} already exists")
        else
          Spaceship::ConnectAPI::BundleId.create(
            name: embedded_name,
            platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
            identifier: embedded
          )
          UI.success("Created #{embedded}")
        end
      end
      bundle = Spaceship::ConnectAPI::BundleId.find(identifier) ||
        Spaceship::ConnectAPI::BundleId.create(
          name: name,
          platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
          identifier: identifier
        )
      if bundle.get_capabilities.any? { |capability| capability.capability_type == push }
        UI.message("Push notifications already enabled on #{identifier}")
      else
        bundle.create_capability(push)
        UI.success("Enabled push notifications on #{identifier}")
      end
    end
    if Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
      UI.message("App Store Connect app already exists")
    else
      # The public API cannot create apps; TestFlight needs the record, Firebase App Distribution does not.
      UI.important("Create the App Store Connect app by hand: https://appstoreconnect.apple.com/apps " \
                   "(New App, iOS, name LocateDo, bundle ID #{APP_IDENTIFIER}, SKU locatedo-ios)")
    end
  end

  # App groups cannot be created with an App Store Connect API key, so this logs in with the Apple ID.
  desc "Create the app groups and turn them on for the apps and their notification extensions (asks for an Apple ID login)"
  lane :app_groups do
    Spaceship::Portal.login(ENV.fetch("FASTLANE_USER"))
    Spaceship::Portal.select_team(team_id: ENV.fetch("APPLE_TEAM_ID"))
    {
      APP_IDENTIFIER => "LocateDo",
      STAGING_APP_IDENTIFIER => "LocateDo Staging",
      DEV_APP_IDENTIFIER => "LocateDo Dev"
    }.each do |identifier, name|
      group_id = "group.#{identifier}"
      group = Spaceship::Portal.app_group.find(group_id) ||
        Spaceship::Portal.app_group.create!(group_id: group_id, name: "#{name} Group")
      [identifier, "#{identifier}#{NOTIFICATION_CONTENT_SUFFIX}"].each do |bundle_identifier|
        app = Spaceship::Portal.app.find(bundle_identifier)
        UI.user_error!("No App ID #{bundle_identifier}; run bootstrap first") unless app
        app = app.update_service(Spaceship::Portal.app_service.app_group.on)
        app.associate_groups([group])
        UI.success("#{bundle_identifier} uses #{group_id}")
      end
    end
  end

  desc "Create or sync the distribution certificate, the App Store profile, and the staging Ad Hoc profile (force:true after a capability change)"
  lane :certificates do |options|
    api_key
    force = options.fetch(:force, false)
    match(type: "appstore", app_identifier: signed_identifiers(APP_IDENTIFIER), force: force)
    match(type: "adhoc", app_identifier: signed_identifiers(STAGING_APP_IDENTIFIER), force: force,
          force_for_new_devices: true)
  end

  desc "Register a device for Ad Hoc builds and refresh the staging Ad Hoc profile (name:, udid:)"
  lane :add_device do |options|
    api_key
    register_device(name: options.fetch(:name), udid: options.fetch(:udid))
    match(type: "adhoc", app_identifier: signed_identifiers(STAGING_APP_IDENTIFIER), force_for_new_devices: true)
  end

  desc "List the devices registered to the team"
  lane :devices do
    api_key
    registered_devices.each do |device|
      UI.message("#{device.status.ljust(8)} #{device.device_class.to_s.ljust(10)} #{device.udid}  #{device.name}")
    end
  end

  desc "Disable every enabled device (the API cannot delete devices; the yearly count resets at renewal)"
  lane :disable_devices do
    api_key
    enabled = registered_devices.select { |device| device.status == "ENABLED" }
    UI.user_error!("No enabled devices") if enabled.empty?
    enabled.each { |device| UI.message("#{device.udid}  #{device.name}") }
    UI.user_error!("Aborted") unless UI.confirm("Disable these #{enabled.count} devices?")
    enabled.each do |device|
      Spaceship::ConnectAPI::Device.disable(device.udid)
      UI.success("Disabled #{device.name}")
    end
  end

  desc "List the bundle identifiers (App IDs) registered to the team"
  lane :bundle_ids do
    api_key
    bundle_identifiers.each do |bundle|
      UI.message("#{bundle.platform.to_s.ljust(10)} #{bundle.identifier.ljust(40)} #{bundle.name}")
    end
  end

  desc "Delete bundle identifiers (identifiers:com.example.a,com.example.b); the app's own identifiers are refused"
  lane :delete_bundle_ids do |options|
    api_key
    wanted = options.fetch(:identifiers).split(",").map(&:strip)
    protected = [APP_IDENTIFIER, STAGING_APP_IDENTIFIER, DEV_APP_IDENTIFIER].flat_map { |identifier| signed_identifiers(identifier) }
    UI.user_error!("Refusing to delete #{(wanted & protected).join(', ')}") unless (wanted & protected).empty?
    registered = bundle_identifiers
    targets = wanted.map do |identifier|
      registered.find { |bundle| bundle.identifier == identifier } ||
        UI.user_error!("No bundle identifier #{identifier}")
    end
    targets.each { |bundle| UI.message("#{bundle.identifier}  #{bundle.name}") }
    UI.user_error!("Aborted") unless UI.confirm("Delete these #{targets.count} bundle identifiers?")
    targets.each { |bundle| delete_bundle_identifier(bundle: bundle) }
  end

  desc "Build a signed Release archive and upload it to TestFlight"
  lane :beta do
    setup_ci if is_ci
    api_key
    match(type: "appstore", app_identifier: signed_identifiers(APP_IDENTIFIER), readonly: true)
    build_number = latest_testflight_build_number(initial_build_number: 0) + 1
    archive(
      app_identifier: APP_IDENTIFIER,
      scheme: "prod",
      configuration: "Release",
      export_method: "app-store",
      profile_type: "appstore",
      build_number: build_number
    )
    upload_to_testflight(changelog: changelog)
    upload_dsyms(configuration: "Release")
  end

  desc "Build a Staging Ad Hoc archive and distribute it through Firebase App Distribution"
  lane :firebase do
    setup_ci if is_ci
    # Read-only match never contacts the developer portal, so staging needs no App Store Connect key.
    match(type: "adhoc", app_identifier: signed_identifiers(STAGING_APP_IDENTIFIER), readonly: true)
    archive(
      app_identifier: STAGING_APP_IDENTIFIER,
      scheme: "stg",
      configuration: "Staging",
      export_method: "ad-hoc",
      profile_type: "adhoc",
      build_number: number_of_commits
    )
    # Without a service account the plugin falls back to the Firebase CLI login (local runs).
    credentials = ENV["FIREBASE_SERVICE_CREDENTIALS_CONTENT"].to_s
    firebase_app_distribution(
      app: ENV.fetch("FIREBASE_APP_ID"),
      service_credentials_json_data: credentials.empty? ? nil : credentials.unpack1("m"),
      groups: ENV["FIREBASE_TESTER_GROUPS"],
      release_notes: changelog
    )
    upload_dsyms(configuration: "Staging")
  end

  # Rewrites only the MARKETING_VERSION lines: saving through the xcodeproj gem would reformat Xcode 27's project.
  desc "Set the app version on every target (bump:patch|minor|major, or version:1.2.3); the build number stays automatic"
  lane :bump_version do |options|
    path = File.expand_path("../#{PROJECT}/project.pbxproj", __dir__)
    pbxproj = File.read(path)
    current = pbxproj.scan(/MARKETING_VERSION = ([^;]+);/).flatten.uniq
    UI.user_error!("Targets disagree on the version: #{current.join(', ')}") unless current.size == 1
    current = current.first
    version = options[:version]
    unless version
      parts = current.split(".").map(&:to_i)
      parts << 0 while parts.size < 3
      case options.fetch(:bump, "patch").to_s
      when "major" then parts = [parts[0] + 1, 0, 0]
      when "minor" then parts = [parts[0], parts[1] + 1, 0]
      when "patch" then parts = [parts[0], parts[1], parts[2] + 1]
      else UI.user_error!("bump must be patch, minor, or major")
      end
      version = parts.join(".")
    end
    UI.user_error!("Not a version: #{version}") unless version.match?(/\A\d+\.\d+(\.\d+)?\z/)
    File.write(path, pbxproj.gsub(/MARKETING_VERSION = [^;]+;/, "MARKETING_VERSION = #{version};"))
    UI.success("Version #{current} -> #{version}. Write fastlane/metadata/*/release_notes.txt for it.")
  end

  desc "Upload the App Store listing, screenshots, app previews, and review notes in fastlane/ (no binary, no submission)"
  lane :metadata do
    notes = File.read(File.expand_path("metadata/review_information/notes.txt", __dir__))
    UI.user_error!("Replace VIDEO_URL in the review notes first") if notes.include?("VIDEO_URL")
    UI.user_error!("The review notes are #{notes.length} characters; App Store Connect takes 4000") if notes.length > 4000
    api_key
    deliver(
      app_identifier: APP_IDENTIFIER,
      app_version: get_version_number(xcodeproj: PROJECT, target: "LocateDo"),
      skip_binary_upload: true,
      overwrite_screenshots: true,
      app_previews_path: APP_PREVIEWS,
      overwrite_preview_videos: true,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false,
      # The contact stays out of this public repo; only the notes live in metadata/.
      app_review_information: {
        first_name: ENV.fetch("APP_REVIEW_FIRST_NAME"),
        last_name: ENV.fetch("APP_REVIEW_LAST_NAME"),
        phone_number: ENV.fetch("APP_REVIEW_PHONE_NUMBER"),
        email_address: ENV.fetch("APP_REVIEW_EMAIL_ADDRESS"),
        demo_required: false,
        notes: notes
      }
    )
  end

  desc "Take the App Store screenshots in English and Japanese (see Snapfile)"
  lane :screenshots do |options|
    device = options.fetch(:device, "iPhone 18 Pro Max")
    udid = simulator_udid(device)
    derived_data = UI_TEST_DERIVED_DATA
    # The store icon replaces the Debug one in the shots.
    sh("xcodebuild", "build-for-testing", "-project", File.expand_path("../#{PROJECT}", __dir__),
       "-scheme", "dev", "-destination", "id=#{udid}", "-derivedDataPath", derived_data,
       "ASSETCATALOG_COMPILER_APPICON_NAME=AppIcon")
    app = File.join(derived_data, "Build/Products/Debug-iphonesimulator/LocateDo.app")
    Dir[File.expand_path("screenshots/*/*.png", __dir__)].each do |file|
      FileUtils.rm_f(file) unless File.basename(file).start_with?(WATCH_SCREENSHOT_PREFIX)
    end
    %w[en-US ja].each do |language|
      # Each language starts from an erased simulator. "Always" can only be granted once the app is
      # installed, and it survives the reinstall the test run does, which keeps the location banner out.
      sh("xcrun", "simctl", "shutdown", udid, error_callback: ->(_) {})
      sh("xcrun", "simctl", "erase", udid)
      # snapshot only localizes the app; the lock screen follows the simulator's own language, which
      # takes a reboot to apply.
      boot_simulator(udid)
      locale = language == "ja" ? "ja_JP" : language.tr("-", "_")
      sh("xcrun", "simctl", "spawn", udid, "defaults", "write", "-g", "AppleLanguages", "-array", language)
      sh("xcrun", "simctl", "spawn", udid, "defaults", "write", "-g", "AppleLocale", "-string", locale)
      sh("xcrun", "simctl", "shutdown", udid)
      boot_simulator(udid)
      sh("xcrun", "simctl", "install", udid, app)
      sh("xcrun", "simctl", "privacy", udid, "grant", "location-always", DEV_APP_IDENTIFIER)
      snapshot(
        devices: [device],
        languages: [language],
        test_without_building: true,
        derived_data_path: derived_data,
        clear_previous_screenshots: false
      )
    end
    compose_screenshots
  end

  desc "Take the Apple Watch screenshots in English and Japanese into fastlane/screenshots/<language>/watch-*.png"
  lane :watch_screenshots do |options|
    device = options.fetch(:device, "Apple Watch Ultra 3 (49mm)")
    udid = watch_simulator_udid(device)
    root = File.expand_path("..", __dir__)
    work = File.join(root, "build/watch-screenshots")
    FileUtils.rm_rf(work)
    project = File.join(root, PROJECT)
    sh("xcodebuild", "build-for-testing", "-project", project, "-scheme", "watch",
       "-destination", "id=#{udid}", "-derivedDataPath", UI_TEST_DERIVED_DATA)
    { "en-US" => "en", "ja" => "ja" }.each do |language, test_language|
      sh("xcrun", "simctl", "shutdown", udid, error_callback: ->(_) {})
      sh("xcrun", "simctl", "erase", udid)
      boot_simulator(udid)
      # watchOS simulators refuse status bar overrides, so the shots show the time they were taken.
      result = File.join(work, "#{language}.xcresult")
      # The test runner sees TEST_RUNNER_-prefixed variables without the prefix.
      sh({ "TEST_RUNNER_SCREENSHOT_LANGUAGE" => test_language },
         "xcodebuild", "test-without-building", "-project", project, "-scheme", "watch",
         "-destination", "id=#{udid}", "-derivedDataPath", UI_TEST_DERIVED_DATA,
         "-only-testing:LocateDoWatchUITests/WatchScreenshotTests", "-resultBundlePath", result)
      attachments = File.join(work, language)
      sh("xcrun", "xcresulttool", "export", "attachments", "--path", result, "--output-path", attachments)
      output = File.expand_path("screenshots/#{language}", __dir__)
      FileUtils.mkdir_p(output)
      Dir[File.join(output, "#{WATCH_SCREENSHOT_PREFIX}*.png")].each { |file| FileUtils.rm_f(file) }
      manifest = JSON.parse(File.read(File.join(attachments, "manifest.json")))
      manifest.flat_map { |test| test["attachments"] }.each do |attachment|
        name = attachment["suggestedHumanReadableName"][/\A\d+-[A-Za-z]+/]
        next unless name
        FileUtils.cp(File.join(attachments, attachment["exportedFileName"]),
                     File.join(output, "#{WATCH_SCREENSHOT_PREFIX}#{name}.png"))
      end
    end
    sh("oxipng", "-o", "4", "--strip", "safe", "-q", *Dir[File.expand_path("screenshots/*/#{WATCH_SCREENSHOT_PREFIX}*.png", __dir__)])
  end

  # Headlines for the App Store images, by screenshot name. Break long ones by hand with \n; compose.swift
  # refuses to wrap on its own.
  SCREENSHOT_HEADLINES = {
    "en-US" => {
      "01-Arrival" => "Reminded the moment\nyou arrive",
      "02-Checked" => "Know when your family\npicks it up",
      "03-Place" => "One list per store,\nshared with family",
      "04-Nearby" => "See what's waiting\nnearby",
      "05-Map" => "Your places on one map",
      "06-Todos" => "Every to-do in one place",
    },
    "ja" => {
      "01-Arrival" => "着いたら、すぐお知らせ",
      "02-Checked" => "家族が買ったら、\nすぐ分かる",
      "03-Place" => "お店ごとのリストを\n家族と共有",
      "04-Nearby" => "近くの用事がひと目で",
      "05-Map" => "場所はマップでも",
      "06-Todos" => "やることを\nまとめてチェック",
    },
  }.freeze

  # Moves snapshot's raw shots to build/screenshots-raw and writes the App Store images, with headlines,
  # to fastlane/screenshots, which deliver uploads.
  private_lane :compose_screenshots do
    root = File.expand_path("..", __dir__)
    output = File.expand_path("screenshots", __dir__)
    raw = File.join(root, "build/screenshots-raw")
    FileUtils.rm_rf(raw)
    FileUtils.mv(output, raw)
    SCREENSHOT_HEADLINES.each do |language, headlines|
      FileUtils.mkdir_p(File.join(output, language))
      headlines.each do |name, headline|
        source = Dir[File.join(raw, language, "*-#{name}.png")].first
        UI.user_error!("No #{language} screenshot for #{name}") unless source
        sh("swift", File.join(root, "../tools/screenshots/compose.swift"), source,
           File.join(output, language, "#{name}.png"), headline, "--language", language.split("-").first)
      end
      Dir[File.join(raw, language, "#{WATCH_SCREENSHOT_PREFIX}*.png")].each do |file|
        FileUtils.cp(file, File.join(output, language))
      end
    end
    # Lossless, so the store sees the same pixels while each retake adds less to the repository.
    sh("oxipng", "-o", "4", "--strip", "safe", "-q", "-r", output)
  end

  desc "Record the walkthrough for App Review into build/review-video/review.mp4 (needs ffmpeg)"
  lane :review_video do |options|
    udid = simulator_udid(options.fetch(:device, "iPhone 18 Pro Max"))
    root = File.expand_path("..", __dir__)
    work = File.join(root, "build/review-video")
    output, recording_started = record_ui_test(udid: udid, work: work, test: "ReviewVideoTests")
    raw = File.join(work, "raw.mp4")

    first = output[/REVIEW_VIDEO_START (\d+\.\d+)/, 1]
    last = output[/REVIEW_VIDEO_END (\d+\.\d+)/, 1]
    UI.user_error!("ReviewVideoTests did not print its start and end") unless first && last
    start = recording_offset(first.to_f, recording_started)
    length = (recording_offset(last.to_f, recording_started) - start).round(2)

    width, height = sh("ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=width,height",
                       "-of", "csv=p=0", raw, log: false).strip.split(",")
    outro = File.join(work, "outro.png")
    # U+2011 keeps "to-dos" from breaking at its hyphen.
    sh("swift", File.join(root, "../tools/video/caption.swift"), outro, width, height,
       "When you get to a saved place, StopBy sends a notification with that place's to\u2011dos, " \
       "even while the app is closed. Your location stays on your iPhone.",
       "--card", "--title", "Reminded when you arrive",
       "--icon", File.join(root, "LocateDo/Assets.xcassets/AppIcon.appiconset/AppIcon.png"))
    scale = "scale=#{width}:#{height},setsar=1,fps=30,format=yuv420p"
    sh("ffmpeg", "-v", "error", "-y",
       "-ss", start.to_s, "-t", length.to_s, "-i", raw, "-loop", "1", "-t", "7", "-i", outro,
       "-filter_complex", "[0]#{scale}[a];[1]#{scale}[b];[a][b]concat=n=2:v=1:a=0",
       "-c:v", "libx264", "-crf", "20", "-movflags", "+faststart", File.join(work, "review.mp4"))
    UI.success("Wrote #{File.join(work, 'review.mp4')}")
  end

  PREVIEW_HOLD = 0.8

  # Captions per scene, in the order the preview tells the story; it closes on the line that leads onboarding, over
  # home. Options: minimum, the least a scene is shown, and how long a scene the test took as a screenshot is shown;
  # caption, extra arguments for caption.swift, such as --top to keep the caption off the notification at the bottom
  # of the lock screen.
  PREVIEW_SCENES = {
    "en-US" => [
      ["arrival", "Get reminded at the store", { minimum: 3.5, caption: "--top" }],
      ["place", "Check things off as you shop"],
      ["map", "All your places on one map"],
      ["todos", "Every list in one place"],
      ["home", "Never forget\nthe milk again"],
    ],
    "ja" => [
      ["arrival", "お店に着いたら、お知らせ", { minimum: 3.5, caption: "--top" }],
      ["place", "買ったらチェック"],
      ["map", "場所はマップでも"],
      ["todos", "買い物リストをまとめて"],
      ["home", "もう、買い忘れない。"],
    ],
  }.freeze

  desc "Record the App Store app previews (886x1920, en-US and ja) into fastlane/app_previews (needs ffmpeg)"
  lane :app_preview do |options|
    udid = simulator_udid(options.fetch(:device, "iPhone 18 Pro Max"))
    root = File.expand_path("..", __dir__)
    caption = File.join(root, "../tools/video/caption.swift")
    PREVIEW_SCENES.each do |language, scenes|
      work = File.join(root, "build/app-preview", language)
      recorded = record_preview_scenes(
        udid: udid, work: work, language: language,
        env: { "TEST_RUNNER_PREVIEW_LANGUAGE" => language.split("-").first }
      )
      inputs = []
      filters = []
      duration = 0.0
      scenes.each_with_index do |(name, text, options), index|
        options ||= {}
        still = File.join(work, "signals", "#{name}.still.png")
        clip = File.join(work, "#{name}.mp4")
        if File.exist?(still)
          length = options.fetch(:minimum)
          inputs += ["-loop", "1", "-t", length.to_s, "-i", still]
        elsif recorded.include?(name)
          # The recording starts capturing a moment after simctl says so, so the clip's own length is used, and its
          # last frame is held a little so the result of the scene can be read.
          length = (sh("ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", clip,
                       log: false).to_f + PREVIEW_HOLD).round(2)
          length = [length, options.fetch(:minimum, 0)].max
          inputs += ["-i", clip]
        else
          UI.user_error!("AppPreviewTests neither recorded nor took a screenshot of the #{name} scene")
        end
        duration += length
        image = File.join(work, "#{name}.png")
        sh("swift", caption, image, "886", "1920", text, *options[:caption])
        inputs += ["-i", image]
        filters << "[#{index * 2}:v]fps=30,tpad=stop_mode=clone:stop_duration=#{length},trim=duration=#{length}," \
                   "setpts=PTS-STARTPTS,scale=886:-2,crop=886:1920,setsar=1,format=yuv420p[v#{index}]"
        filters << "[v#{index}][#{index * 2 + 1}:v]overlay=0:0[c#{index}]"
      end
      UI.user_error!("The #{language} preview runs #{duration.round(1)} s; it must be 15-30 s") unless (15..30).cover?(duration)
      labels = scenes.each_index.map { |index| "[c#{index}]" }.join
      filters << "#{labels}concat=n=#{scenes.size}:v=1:a=0[video]"
      folder = File.join(APP_PREVIEWS, language)
      FileUtils.mkdir_p(folder)
      # App previews need a stereo audio track, even a silent one.
      sh("ffmpeg", "-v", "error", "-y", *inputs,
         "-f", "lavfi", "-i", "anullsrc=channel_layout=stereo:sample_rate=48000",
         "-filter_complex", filters.join(";"), "-map", "[video]", "-map", "#{scenes.size * 2}:a",
         "-c:v", "libx264", "-profile:v", "high", "-crf", "18", "-r", "30",
         "-c:a", "aac", "-b:a", "256k", "-shortest", "-movflags", "+faststart",
         File.join(folder, APP_PREVIEW_FILE))
      UI.success("Wrote fastlane/app_previews/#{language}/#{APP_PREVIEW_FILE} (#{duration.round(1)} s)")
    end
  end

  # App privacy answers need an Apple ID session; an App Store Connect API key cannot set them.
  desc "Upload the App Privacy answers in fastlane/app_privacy_details.json (asks for an Apple ID login)"
  lane :app_privacy do
    upload_app_privacy_details_to_app_store(
      username: ENV.fetch("FASTLANE_USER"),
      app_identifier: APP_IDENTIFIER,
      json_path: File.expand_path("app_privacy_details.json", __dir__)
    )
  end

  private_lane :api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_CONTENT"),
      is_key_content_base64: true
    )
  end

  # The Release and Staging configurations carry the match profiles in the project; Debug stays automatic.
  private_lane :archive do |options|
    profiles = signed_identifiers(options.fetch(:app_identifier)).to_h do |identifier|
      [identifier, ENV.fetch("sigh_#{identifier}_#{options[:profile_type]}_profile-name")]
    end
    build_app(
      project: PROJECT,
      scheme: options.fetch(:scheme),
      configuration: options.fetch(:configuration),
      export_method: options[:export_method],
      export_options: { provisioningProfiles: profiles },
      output_directory: "build",
      derived_data_path: ARCHIVE_DERIVED_DATA,
      xcargs: "CURRENT_PROJECT_VERSION=#{options[:build_number]}"
    )
  end

  private_lane :upload_dsyms do |options|
    upload_symbols_to_crashlytics(
      dsym_path: lane_context[SharedValues::DSYM_OUTPUT_PATH],
      gsp_path: File.expand_path("../LocateDo/Firebase/GoogleService-Info-#{options.fetch(:configuration)}.plist", __dir__),
      binary_path: File.join(ARCHIVE_DERIVED_DATA, "SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/upload-symbols")
    )
  end

  private_lane :connect_api do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(
      hash: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
    )
  end

  private_lane :registered_devices do
    connect_api
    Spaceship::ConnectAPI::Device.all
  end

  private_lane :bundle_identifiers do
    connect_api
    Spaceship::ConnectAPI::BundleId.all
  end

  # Spaceship has no delete for bundle IDs, so this calls DELETE /v1/bundleIds/{id} directly.
  private_lane :delete_bundle_identifier do |options|
    bundle = options.fetch(:bundle)
    Spaceship::ConnectAPI.provisioning_request_client.delete("v1/bundleIds/#{bundle.id}")
    UI.success("Deleted #{bundle.identifier}")
  rescue Spaceship::UnexpectedResponse => e
    detail = e.message[/"detail" : "([^"]+)"/, 1] || e.message.lines.first.to_s.strip
    UI.error("Could not delete #{bundle.identifier}: #{detail}")
  end

  private_lane :changelog do
    changelog_from_git_commits(
      commits_count: 10,
      pretty: "- %s",
      merge_commit_filtering: "exclude_merges"
    )
  end
end
