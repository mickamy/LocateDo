default_platform(:android)
skip_docs

ROOT = File.expand_path("..", __dir__)
SDK = ENV.fetch("ANDROID_HOME", File.expand_path("~/Library/Android/sdk"))

# A throwaway emulator, created and deleted by the screenshots lane so it never touches your own devices.
SCREENSHOT_AVD = "locatedo-screenshots"
SCREENSHOT_SERIAL = "emulator-5580"
SCREENSHOT_PACKAGE = "com.locatedo.locatedo.dev"
SCREENSHOT_RECEIVER = "#{SCREENSHOT_PACKAGE}/com.locatedo.locatedo.debug.ScreenshotReceiver"

# The App Store headlines, so both stores tell the same story. Break long ones by hand with \n.
SCREENSHOT_HEADLINES = {
  "en-US" => {
    "01-Arrival" => "Reminded the moment\nyou arrive",
    "02-Nearby" => "See what's waiting\nnearby",
    "03-Place" => "A list for every store",
    "04-Map" => "Your places on one map",
    "05-Todos" => "Every to-do in one place",
  },
  "ja-JP" => {
    "01-Arrival" => "着いたら、すぐお知らせ",
    "02-Nearby" => "近くの用事がひと目で",
    "03-Place" => "お店ごとの買い物リスト",
    "04-Map" => "場所はマップでも",
    "05-Todos" => "やることを\nまとめてチェック",
  },
}.freeze

def app_string(name, language)
  values = language == "en" ? "values" : "values-#{language}"
  File.read(File.join(ROOT, "app/src/main/res/#{values}/strings.xml"))[/name="#{name}">([^<]+)</, 1]
end

# Taps the element whose accessibility label is the app's string `name` in that language, wherever it is drawn.
def tap_label(name, language)
  label = app_string(name, language)
  tap_node("label #{label.inspect}") { |node| node.include?("content-desc=\"#{label}\"") }
end

# Taps the element showing `text` (a string or a pattern), in the app or in system screens.
def tap_text(text)
  tap_node("text #{text.inspect}") do |node|
    shown = node[/ text="([^"]*)"/, 1]
    text.is_a?(Regexp) ? text.match?(shown.to_s) : shown == text
  end
end

def tap_node(description)
  screen = adb("exec-out", "uiautomator", "dump", "/dev/tty").force_encoding(Encoding::UTF_8)
  node = screen.scan(/<node [^>]*>/).find { |n| yield(n) }
  UI.user_error!("No element with #{description} on screen") if node.nil?
  x1, y1, x2, y2 = node[/bounds="([^"]+)"/, 1].scan(/\d+/).map(&:to_i)
  adb("shell", "input", "tap", ((x1 + x2) / 2).to_s, ((y1 + y2) / 2).to_s)
end

# Where the emulator stands; the seeded places sit around it (debug ScreenshotSeed).
SCREENSHOT_LOCATIONS = {
  "en-US" => { language: "en", latitude: 37.77627, longitude: -122.41924 },
  "ja-JP" => { language: "ja", latitude: 35.67824, longitude: 139.76712 },
}.freeze

# Quiet on success, but a failure says which command it was and what adb printed.
def adb(*args)
  failed = ->(output) { UI.user_error!("adb #{args.join(' ')} failed:\n#{output}") }
  Fastlane::Actions.sh(File.join(SDK, "platform-tools/adb"), "-s", SCREENSHOT_SERIAL, *args, log: false,
                       error_callback: failed)
end

# A stray tap or key can land on the launcher or another app; stop rather than publish that as a screenshot, and
# show the app's last crash, since the throwaway emulator and its logs are gone afterwards.
def ensure_in_front(step)
  top = adb("shell", "dumpsys", "activity", "activities").lines.find { |line| line.include?("topResumedActivity") }
  return if top&.include?(SCREENSHOT_PACKAGE)

  crash = adb("logcat", "-d", "-b", "crash").lines.last(20).join
  # Why the app went away when it did not crash: killed for memory, or something else brought up the launcher.
  events = /#{Regexp.escape(SCREENSHOT_PACKAGE)}|am_kill|am_proc_died|START u0/
  system = adb("logcat", "-d", "-b", "system", "-b", "events").lines.grep(events).last(20).join
  screen = adb("exec-out", "uiautomator", "dump", "/dev/tty").force_encoding(Encoding::UTF_8)
  texts = screen.scan(/ text="([^"]+)"/).flatten.join(" | ")
  UI.user_error!("#{step}: #{SCREENSHOT_PACKAGE} is not in front (#{top&.strip})\n#{texts}\n#{crash}\n#{system}")
end

# Taps and swipes go by coordinates, so they first check the app is still in front; otherwise they would land on the
# launcher and open whatever sits there.
def tap_app(x, y, step)
  ensure_in_front(step)
  adb("shell", "input", "tap", x.to_s, y.to_s)
end

def swipe_app(from_y, to_y, step)
  ensure_in_front(step)
  adb("shell", "input", "swipe", "540", from_y.to_s, "540", to_y.to_s, "600")
end

def capture(path)
  ensure_in_front(File.basename(path))
  adb("shell", "screencap", "-p", "/sdcard/screenshot.png")
  adb("pull", "/sdcard/screenshot.png", path)
end

# CI passes the Play service account key base64-encoded; a local run reads the key from credentials/.
def play_json_key
  encoded = ENV["PLAY_SERVICE_ACCOUNT_JSON"].to_s
  return encoded.unpack1("m") unless encoded.empty?

  path = File.join(ROOT, "credentials/play-service-account.json")
  UI.user_error!("Set PLAY_SERVICE_ACCOUNT_JSON or put the key at #{path}") unless File.exist?(path)
  File.read(path)
end

platform :android do
  desc "Build the Staging APK and distribute it through Firebase App Distribution"
  lane :firebase do
    require_build_inputs(build_type: "staging", keystore: "staging")
    build(task: "assemble", build_type: "Staging", version_code: number_of_commits)
    # Without a service account the plugin falls back to the Firebase CLI login (local runs).
    credentials = ENV["FIREBASE_SERVICE_CREDENTIALS_CONTENT"].to_s
    firebase_app_distribution(
      app: ENV.fetch("ANDROID_FIREBASE_APP_ID"),
      android_artifact_type: "APK",
      android_artifact_path: lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH],
      service_credentials_json_data: credentials.empty? ? nil : credentials.unpack1("m"),
      groups: ENV["FIREBASE_TESTER_GROUPS"],
      release_notes: changelog
    )
  end

  desc "Build the Release AAB and upload it to the internal testing track on Google Play"
  lane :beta do
    require_build_inputs(build_type: "release", keystore: "upload")
    json_key = play_json_key
    version_code = google_play_track_version_codes(track: "internal", json_key_data: json_key).max.to_i + 1
    build(task: "bundle", build_type: "Release", version_code: version_code)
    upload_to_play_store(
      track: "internal",
      json_key_data: json_key,
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      mapping: lane_context[SharedValues::GRADLE_MAPPING_TXT_OUTPUT_PATH],
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload the store listing (text and images in fastlane/metadata) to Google Play"
  lane :metadata do
    json_key = play_json_key
    # supply looks up a release even when only the listing changes, and fails on an empty version code; the listing
    # itself is app-wide, so pointing at the latest internal build changes nothing else.
    version_code = google_play_track_version_codes(track: "internal", json_key_data: json_key).max
    upload_to_play_store(
      json_key_data: json_key,
      track: "internal",
      version_code: version_code,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      sync_image_upload: true
    )
  end

  desc "Take the Play screenshots on a throwaway emulator and add the App Store headlines"
  lane :screenshots do
    build(task: "assemble", build_type: "Debug", version_code: 1)
    apk = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]
    raw = File.join(ROOT, "build/screenshots-raw")
    FileUtils.rm_rf(raw)
    with_screenshot_emulator do
      disable_interrupting_apps
      adb("install", "-r", apk)
      %w[ACCESS_FINE_LOCATION ACCESS_COARSE_LOCATION ACCESS_BACKGROUND_LOCATION POST_NOTIFICATIONS].each do |permission|
        adb("shell", "pm", "grant", SCREENSHOT_PACKAGE, "android.permission.#{permission}")
      end
      enter_demo_mode
      SCREENSHOT_LOCATIONS.each do |locale, location|
        dir = File.join(raw, locale)
        FileUtils.mkdir_p(dir)
        take_screenshots(locale, location, dir)
      end
    end
    compose_screenshots(raw)
  end

  desc "Record the background location walkthrough for Play's declaration into build/location-video (needs ffmpeg)"
  lane :location_video do
    build(task: "assemble", build_type: "Debug", version_code: 1)
    apk = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]
    work = File.join(ROOT, "build/location-video")
    FileUtils.rm_rf(work)
    FileUtils.mkdir_p(work)
    location = SCREENSHOT_LOCATIONS.fetch("en-US")
    # The first seeded place, the grocery store.
    grocery = { latitude: location.fetch(:latitude) + 0.0030, longitude: location.fetch(:longitude) }
    with_screenshot_emulator do
      disable_interrupting_apps
      adb("install", "-r", apk)
      adb("shell", "appops", "set", SCREENSHOT_PACKAGE, "android:mock_location", "allow")
      # Background location is left out: asking for it is what the video shows.
      %w[ACCESS_FINE_LOCATION ACCESS_COARSE_LOCATION POST_NOTIFICATIONS].each do |permission|
        adb("shell", "pm", "grant", SCREENSHOT_PACKAGE, "android.permission.#{permission}")
      end
      # A fresh emulator has Google Location Accuracy off, and geofences then fail with GEOFENCE_NOT_AVAILABLE.
      adb("shell", "am", "start", "-a", "com.google.android.gms.location.settings.LOCATION_ACCURACY")
      sleep(3)
      tap_text("Improve Location Accuracy")
      sleep(2)
      adb("shell", "cmd", "locale", "set-app-locales", SCREENSHOT_PACKAGE, "--locales", "en-US")
      adb("emu", "geo", "fix", location.fetch(:longitude).to_s, location.fetch(:latitude).to_s)
      adb("shell", "am", "broadcast", "-n", SCREENSHOT_RECEIVER, "-a", "seed", "--es", "language", "en")
      sleep(3)
      adb("shell", "am", "start", "-n", "#{SCREENSHOT_PACKAGE}/com.locatedo.locatedo.MainActivity")
      sleep(15)
      tap_label("home_my_location", "en")
      sleep(8)

      record(File.join(work, "ask.mp4")) do
        sleep(2)
        tap_text(/\ASet location to/)
        # Long enough to read the disclosure.
        sleep(6)
        tap_text(app_string("settings_open_settings", "en"))
        sleep(3)
        tap_text(/\AAllow all the time\z/)
        sleep(2)
        adb("shell", "input", "keyevent", "KEYCODE_BACK")
        sleep(3)
        adb("shell", "input", "keyevent", "KEYCODE_HOME")
        sleep(2)
      end

      # The geofence fires on DWELL, about two minutes after arriving; a card stands in for the wait.
      wait_for_notification(grocery)
      record(File.join(work, "arrive.mp4")) do
        sleep(1)
        adb("shell", "cmd", "statusbar", "expand-notifications")
        sleep(5)
      end
    end
    compose_location_video(work)
  end

  # Play's API cannot upload to an app that has no build yet, so the first AAB goes up through Play Console.
  desc "Build the Release AAB without uploading it"
  lane :build_release do
    require_build_inputs(build_type: "release", keystore: "upload")
    build(task: "bundle", build_type: "Release", version_code: 1)
    UI.success("Wrote #{lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]}")
  end

  # Gradle builds without these too, but signs with the debug key or leaves the Firebase config out.
  private_lane :require_build_inputs do |options|
    keystore = File.join(ROOT, "credentials/#{options.fetch(:keystore)}.jks")
    UI.user_error!("Missing #{keystore}") unless File.exist?(keystore)
    config = File.join(ROOT, "app/src/#{options.fetch(:build_type)}/google-services.json")
    UI.user_error!("Missing #{config}") unless File.exist?(config)
  end

  private_lane :build do |options|
    gradle(
      project_dir: ROOT,
      task: options.fetch(:task),
      build_type: options.fetch(:build_type),
      properties: { "LOCATEDO_VERSION_CODE" => options.fetch(:version_code) }
    )
  end

  def with_screenshot_emulator
    avd_dir = File.expand_path("~/.android/avd")
    image = "system-images/android-37.0/google_apis_playstore/arm64-v8a/"
    UI.user_error!("Missing #{File.join(SDK, image)}") unless File.directory?(File.join(SDK, image))
    FileUtils.mkdir_p(File.join(avd_dir, "#{SCREENSHOT_AVD}.avd"))
    File.write(File.join(avd_dir, "#{SCREENSHOT_AVD}.ini"), <<~INI)
      avd.ini.encoding=UTF-8
      path=#{avd_dir}/#{SCREENSHOT_AVD}.avd
      target=android-37.0
    INI
    File.write(File.join(avd_dir, "#{SCREENSHOT_AVD}.avd/config.ini"), <<~INI)
      AvdId=#{SCREENSHOT_AVD}
      PlayStore.enabled=true
      abi.type=arm64-v8a
      hw.cpu.arch=arm64
      hw.gps=yes
      hw.gpu.enabled=yes
      hw.keyboard=yes
      hw.lcd.density=420
      hw.lcd.height=2400
      hw.lcd.width=1080
      hw.ramSize=2048
      disk.dataPartition.size=6G
      image.sysdir.1=#{image}
      tag.id=google_apis_playstore
      target=android-37.0
    INI
    emulator = Process.spawn(
      File.join(SDK, "emulator/emulator"), "-avd", SCREENSHOT_AVD, "-port", SCREENSHOT_SERIAL.split("-").last,
      "-no-window", "-no-audio", "-no-boot-anim", "-no-snapshot", "-wipe-data", "-gpu", "swiftshader_indirect",
      out: File::NULL, err: File::NULL
    )
    begin
      adb("wait-for-device")
      sleep(2) until adb("shell", "getprop", "sys.boot_completed").strip == "1"
      yield
    ensure
      adb("emu", "kill") rescue nil
      Process.wait(emulator)
      FileUtils.rm_rf(File.join(avd_dir, "#{SCREENSHOT_AVD}.avd"))
      FileUtils.rm_f(File.join(avd_dir, "#{SCREENSHOT_AVD}.ini"))
    end
  end

  # Preinstalled apps finish setting themselves up on a fresh emulator and take the screen in the middle of a run: the
  # Google app and YouTube come to the front, any app may ask for the notification permission, and the Play Store
  # updates Google Play services, which kills every app that loaded its code (ours does, for Maps). Every app but ours
  # has the notification permission denied for good, in one shell on the device rather than an adb call per package.
  def disable_interrupting_apps
    %w[com.android.vending com.google.android.googlequicksearchbox com.google.android.youtube].each do |package|
      adb("shell", "pm", "disable-user", "--user", "0", package)
    end
    permission = "android.permission.POST_NOTIFICATIONS"
    adb("shell", "for p in $(pm list packages | cut -d: -f2); do " \
                 "[ \"$p\" = #{SCREENSHOT_PACKAGE} ] && continue; " \
                 "pm revoke $p #{permission} 2>/dev/null && pm set-permission-flags $p #{permission} user-fixed; " \
                 "done; true")
  end

  # 9:41, full battery, and no notification icons, as on the App Store images.
  def enter_demo_mode
    adb("shell", "settings", "put", "global", "sysui_demo_allowed", "1")
    [
      %w[command enter],
      %w[command clock -e hhmm 0941],
      %w[command battery -e level 100 -e plugged false],
      %w[command network -e wifi show -e level 4 -e mobile hide],
      %w[command notifications -e visible false],
    ].each do |extras|
      adb("shell", "am", "broadcast", "-a", "com.android.systemui.demo", "-e", *extras)
    end
  end

  # Taps assume the 1080x2400 emulator created above. The map is recentered and given time before each map shot,
  # since a fresh emulator loads tiles slowly.
  def take_screenshots(locale, location, dir)
    language = location.fetch(:language)
    activity = "#{SCREENSHOT_PACKAGE}/com.locatedo.locatedo.MainActivity"
    adb("shell", "am", "force-stop", SCREENSHOT_PACKAGE)
    adb("shell", "cmd", "locale", "set-app-locales", SCREENSHOT_PACKAGE, "--locales", locale)
    adb("emu", "geo", "fix", location.fetch(:longitude).to_s, location.fetch(:latitude).to_s)
    adb("shell", "am", "broadcast", "-n", SCREENSHOT_RECEIVER, "-a", "seed", "--es", "language", language)
    sleep(3)
    adb("shell", "am", "start", "-n", activity)
    sleep(15)
    recenter_map
    capture(File.join(dir, "04-Map.png"))

    swipe_app(1990, 900, "raise the sheet")
    sleep(4)
    capture(File.join(dir, "02-Nearby.png"))
    swipe_app(160, 2100, "lower the sheet")
    sleep(3)

    adb("shell", "am", "start", "-n", activity, "-f", "0x20000000",
        "--es", "placeId", "0199a6f0-0000-7000-8000-000000000001")
    sleep(8)
    capture(File.join(dir, "03-Place.png"))
    # The sheet's close button, not BACK: BACK sometimes left the app, and the next taps landed on the launcher.
    tap_label("common_done", language)
    sleep(2)

    tap_app(540, 2270, "open the to-do tab")
    sleep(4)
    capture(File.join(dir, "05-Todos.png"))
    tap_app(172, 2270, "open the home tab")
    sleep(3)
    recenter_map

    adb("shell", "am", "broadcast", "-n", SCREENSHOT_RECEIVER, "-a", "notify", "--es", "language", language)
    sleep(1.5)
    capture(File.join(dir, "01-Arrival.png"))
  end

  def recenter_map
    tap_app(964, 1759, "recenter the map")
    sleep(8)
  end

  def compose_screenshots(raw)
    SCREENSHOT_HEADLINES.each do |locale, headlines|
      output = File.join(ROOT, "fastlane/metadata/android/#{locale}/images/phoneScreenshots")
      FileUtils.rm_rf(output)
      FileUtils.mkdir_p(output)
      headlines.each do |name, headline|
        sh("swift", File.join(ROOT, "../tools/screenshots/compose.swift"), File.join(raw, locale, "#{name}.png"),
           File.join(output, "#{name}.png"), headline, "--language", SCREENSHOT_LOCATIONS.fetch(locale).fetch(:language),
           "--corner", "0.06")
      end
      sh("oxipng", "-o", "4", "--strip", "safe", "-q", "-r", output)
    end
  end

  # screenrecord finishes the file only when stopped with SIGINT.
  def record(path)
    recorder = Process.spawn(File.join(SDK, "platform-tools/adb"), "-s", SCREENSHOT_SERIAL,
                             "shell", "screenrecord", "--time-limit", "180", "/sdcard/clip.mp4",
                             out: File::NULL, err: File::NULL)
    sleep(1)
    begin
      yield
    ensure
      adb("shell", "pkill", "-INT", "screenrecord")
      Process.wait(recorder)
    end
    sleep(1)
    adb("pull", "/sdcard/clip.mp4", path)
  end

  # Keeps reporting the place as the current location (debug ScreenshotReceiver), since a geofence only dwells on
  # fresh fixes.
  def wait_for_notification(place)
    deadline = Time.now + 300
    until adb("shell", "dumpsys", "notification").include?("pkg=#{SCREENSHOT_PACKAGE}")
      if Time.now > deadline
        background = adb("shell", "dumpsys", "package", SCREENSHOT_PACKAGE).lines.grep(/BACKGROUND_LOCATION/).join
        logs = adb("logcat", "-d", "-s", "Geofence", "GeofenceSync", "GeofencingClient").lines.last(30).join
        UI.user_error!("No arrival notification within 5 minutes\n#{background}\n#{logs}")
      end
      adb("shell", "am", "broadcast", "-n", SCREENSHOT_RECEIVER, "-a", "move",
          "--es", "latitude", place.fetch(:latitude).to_s, "--es", "longitude", place.fetch(:longitude).to_s)
      sleep(5)
    end
  end

  def compose_location_video(work)
    ask = File.join(work, "ask.mp4")
    width, height = sh("ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=width,height",
                       "-of", "csv=p=0", ask, log: false).strip.split(",")
    card = File.join(work, "card.png")
    # U+2011 keeps "to-dos" from breaking at its hyphen.
    sh("swift", File.join(ROOT, "../tools/video/caption.swift"), card, width, height,
       "StopBy stays closed. About two minutes after the phone arrives at the grocery store, " \
       "a notification lists that place's to‑dos.",
       "--card", "--title", "Arriving at the store",
       "--icon", File.join(ROOT, "fastlane/metadata/android/en-US/images/icon.png"))
    scale = "scale=#{width}:#{height},setsar=1,fps=30,format=yuv420p"
    output = File.join(work, "location.mp4")
    sh("ffmpeg", "-v", "error", "-y",
       "-i", ask, "-loop", "1", "-t", "5", "-i", card, "-i", File.join(work, "arrive.mp4"),
       "-filter_complex", "[0]#{scale}[a];[1]#{scale}[b];[2]#{scale}[c];[a][b][c]concat=n=3:v=1:a=0",
       "-c:v", "libx264", "-crf", "20", "-movflags", "+faststart", output)
    UI.success("Wrote #{output}")
  end

  private_lane :changelog do
    changelog_from_git_commits(
      commits_count: 10,
      pretty: "- %s",
      merge_commit_filtering: "exclude_merges"
    )
  end
end
