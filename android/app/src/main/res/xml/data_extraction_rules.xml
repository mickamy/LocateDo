<?xml version="1.0" encoding="utf-8"?>
<!-- The signed-in session stays on the device that created it; everything else is restored. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="datastore/session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="datastore/session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
