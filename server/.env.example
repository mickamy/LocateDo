# App
ENV=development
MODULE_ROOT=${PWD}

# Database
DATABASE_URL=postgres://admin:password@127.0.0.1:5432/locatedo?sslmode=disable
DATABASE_WRITER_URL=postgres://locatedo_writer:password@127.0.0.1:5432/locatedo?sslmode=disable
DATABASE_READER_URL=postgres://locatedo_reader:password@127.0.0.1:5432/locatedo?sslmode=disable

# `make .env` fills every ${...} from the environment. Locally the keys below
# are random and the Apple / RevenueCat values stay empty; CI passes them from
# GitHub Secrets. Private keys are base64 of the .p8 file, one line.

# Auth
JWT_SIGNING_KEY=${JWT_SIGNING_KEY}
SEAL_KEY=${SEAL_KEY}

# Sign in with Apple (empty in development: sign-in fails at the code exchange)
APPLE_BUNDLE_ID=${APPLE_BUNDLE_ID}
APPLE_TEAM_ID=${APPLE_TEAM_ID}
APPLE_KEY_ID=${APPLE_KEY_ID}
APPLE_PRIVATE_KEY=${APPLE_PRIVATE_KEY}

# APNs (empty key in development: pushes are logged and dropped)
APNS_KEY_ID=${APNS_KEY_ID}
APNS_PRIVATE_KEY=${APNS_PRIVATE_KEY}
APNS_TOPIC=${APNS_TOPIC}
APNS_ENVIRONMENT=${APNS_ENVIRONMENT}

# RevenueCat (empty in development: the webhook refuses calls and plans stay free)
REVENUECAT_API_KEY=${REVENUECAT_API_KEY}
REVENUECAT_WEBHOOK_AUTH=${REVENUECAT_WEBHOOK_AUTH}

# Cloudflare Tunnel (staging and production only; empty in development)
CLOUDFLARE_TUNNEL_TOKEN=${CLOUDFLARE_TUNNEL_TOKEN}
