# App
ENV=development
MODULE_ROOT=${PWD}

# Database
DATABASE_URL=postgres://admin:password@127.0.0.1:5432/locatedo?sslmode=disable
DATABASE_WRITER_URL=postgres://locatedo_writer:password@127.0.0.1:5432/locatedo?sslmode=disable
DATABASE_READER_URL=postgres://locatedo_reader:password@127.0.0.1:5432/locatedo?sslmode=disable

# Auth (`make .env` fills these with random values)
JWT_SIGNING_KEY=${JWT_SIGNING_KEY}
SEAL_KEY=${SEAL_KEY}

# Sign in with Apple (empty in development: sign-in fails at the code exchange)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
