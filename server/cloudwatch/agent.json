{
  "agent": {
    "metrics_collection_interval": 60
  },
  "metrics": {
    "namespace": "LocateDo/Host",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "mem": {
        "measurement": ["mem_used_percent"]
      },
      "disk": {
        "measurement": ["used_percent"],
        "resources": ["/", "/var/lib/locatedo"],
        "drop_device": true
      }
    }
  }
}
