#!/bin/bash
set -euxo pipefail

dnf install -y docker
systemctl enable --now docker

compose_version=v5.6.0
compose_sha256=733ec76717ceb59052a9609b9dadfb523b2df8eab57a54212872d10a58078ea2
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-compose \
  "https://github.com/docker/compose/releases/download/$${compose_version}/docker-compose-linux-aarch64"
echo "$${compose_sha256}  /usr/local/lib/docker/cli-plugins/docker-compose" | sha256sum -c -
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# The data volume is attached after the instance starts; Nitro exposes it as NVMe by volume id.
device=/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${replace(data_volume_id, "-", "")}
for _ in $(seq 1 60); do
  [ -e "$device" ] && break
  sleep 5
done
if ! blkid "$device"; then
  mkfs.ext4 -L locatedo-data "$device"
fi
mkdir -p /var/lib/locatedo
echo "LABEL=locatedo-data /var/lib/locatedo ext4 defaults,nofail 0 2" >> /etc/fstab
mount /var/lib/locatedo
